<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-BackendError">
    <DisplayName>AM-BackendError</DisplayName>
    <Set>
        <Payload contentType="application/json">{"error":"upstream_unavailable","message":"The weather provider is unavailable. Try again later.","messageid":"{messageid}"}</Payload>
        <StatusCode>502</StatusCode>
        <ReasonPhrase>Bad Gateway</ReasonPhrase>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
